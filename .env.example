APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# ── PayMongo gateway (see docs/PAYMONGO_SETUP.md) ───────────────────────────
# Disabled by default: with PAYMONGO_ENABLED=false a gateway method is simply
# recorded as a declared method and no external call is made.
# Use SANDBOX test keys (sk_test_ / pk_test_) to develop at zero cost.
PAYMONGO_ENABLED=false
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_BASE_URL=https://api.paymongo.com/v1
PAYMONGO_CURRENCY=PHP
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_SUCCESS_URL=/payment/returned
PAYMONGO_CANCEL_URL=/payment/cancelled
PAYMONGO_WEBHOOK_URL=/webhooks/paymongo
PAYMONGO_STATEMENT_DESCRIPTOR=SMARTCOMMUTE

# Audit trail (activity_log): days to keep entries; the daily activitylog:clean job deletes older ones
ACTIVITY_LOG_RETENTION_DAYS=365

# Driver inactivity: warn after this many days without clocking in, suspend after more than this many; HR_EMAIL is quoted in the warning
DRIVER_INACTIVITY_WARN_AFTER_DAYS=3
DRIVER_INACTIVITY_SUSPEND_AFTER_DAYS=7
HR_EMAIL=

# Notifications: comma-separated channels every automatic message uses (only `mail` exists today)
NOTIFICATION_CHANNELS=mail

# Payment gateway: reconcile pending payments older than this many minutes; alert the Admins at N errors within M minutes
PAYMONGO_RECONCILE_AFTER_MINUTES=5
GATEWAY_FAILURE_THRESHOLD=3
GATEWAY_FAILURE_WINDOW_MINUTES=15

# Ride QR: match the commuter to a broadcasting vehicle within this many metres; require it before a fare can be paid
QR_NEARBY_METERS=150
QR_REQUIRE_NEARBY_VEHICLE=false

# Flags: drivers with N violations in M days; commuters with N unpaid scans in M days
REPEAT_VIOLATOR_COUNT=3
REPEAT_VIOLATOR_DAYS=30
FARE_EVASION_SCANS=3
FARE_EVASION_DAYS=7

# Scheduled reports: also attach the audit trail for the period
REPORT_ATTACH_ACTIVITY_LOG=true

# Replacement drivers: assign a free driver when a vehicle loses one; take drivers with an expired licence off their vehicle
AUTO_REPLACE_DRIVERS=true
RELEASE_EXPIRED_LICENCE_DRIVERS=true

# Scan a vehicle's OR/CR with a phone (needs: sudo apt-get install -y tesseract-ocr). The photos are read on this server only.
VEHICLE_SCAN_ENABLED=true
TESSERACT_BINARY=tesseract
VEHICLE_SCAN_TTL_MINUTES=15
